{
  "name": "egress",
  "version": "0.1.0",
  "private": true,
  "description": "Capacity-constrained evacuation planning at incident tempo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "data:network": "tsx scripts/fetch-network.ts",
    "data:hazard": "tsx scripts/fetch-hazard.ts",
    "data:population": "tsx scripts/fetch-population.ts",
    "data:facilities": "tsx scripts/fetch-facilities.ts",
    "data:weather": "tsx scripts/fetch-weather.ts",
    "data:zones:official": "tsx scripts/fetch-evac-zones.ts",
    "data:zones": "tsx scripts/build-zones.ts",
    "data:buildings": "tsx scripts/fetch-buildings.ts",
    "data:blocks": "tsx scripts/fetch-blocks.ts",
    "data:context": "tsx scripts/fetch-context-layers.ts",
    "data:field": "tsx scripts/build-hazard-field.ts",
    "data:simulate": "tsx scripts/simulate.ts",
    "data:all": "npm run data:network && npm run data:hazard && npm run data:population && npm run data:facilities && npm run data:weather && npm run data:zones && npm run data:field && npm run data:simulate"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.2",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@deck.gl/react": "^9.3.2",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
